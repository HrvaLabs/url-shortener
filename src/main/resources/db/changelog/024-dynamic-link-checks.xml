    <changeSet author="khrvacic" id="024-link-review-table">
        <createTable tableName="link_review">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="url_id" type="BIGINT">
                <constraints nullable="false" foreignKeyName="LINK_REVIEW_URL_FK" referencedTableName="URL"
                             referencedColumnNames="ID" deleteCascade="true"/>
            </column>
            <column name="reasons" type="TEXT">
                <constraints nullable="false"/>
            </column>
            <column name="flagged_at" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="resolved_at" type="TIMESTAMP"/>
            <column name="resolved_by" type="VARCHAR(255)"/>
            <column name="resolution" type="VARCHAR(30)"/>
        </createTable>
        <rollback>
            <dropTable tableName="link_review"/>
        </rollback>
    </changeSet>

    <changeSet author="khrvacic" id="024-link-review-indexes">
        <createIndex tableName="link_review" indexName="idx_link_review_resolved_at">
            <column name="resolved_at"/>
        </createIndex>
        <createIndex tableName="link_review" indexName="idx_link_review_url_id">
            <column name="url_id"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="link_review" indexName="idx_link_review_url_id"/>
            <dropIndex tableName="link_review" indexName="idx_link_review_resolved_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
