<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet author="khrvacic" id="024-url-block-reason">
        <addColumn tableName="URL">
            <column name="BLOCK_REASON" type="VARCHAR(30)"/>
            <column name="BLOCK_DETAIL" type="VARCHAR(255)"/>
            <column name="BLOCKED_AT" type="TIMESTAMP"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="URL" columnName="BLOCKED_AT"/>
            <dropColumn tableName="URL" columnName="BLOCK_DETAIL"/>
            <dropColumn tableName="URL" columnName="BLOCK_REASON"/>
        </rollback>
    </changeSet>

    <changeSet author="khrvacic" id="024-url-block-reason-safe-browsing-backfill">
        <update tableName="URL">
            <column name="BLOCK_REASON" value="SAFE_BROWSING"/>
            <where>THREAT_TYPE IS NOT NULL</where>
        </update>
        <rollback/>
    </changeSet>

    <changeSet author="khrvacic" id="024-url-blocked-at-index">
        <createIndex tableName="URL" indexName="idx_url_blocked_at">
            <column name="BLOCKED_AT"/>
        </createIndex>
        <rollback>
            <dropIndex tableName="URL" indexName="idx_url_blocked_at"/>
        </rollback>
    </changeSet>

    <changeSet author="khrvacic" id="024-url-redirect-chain">
        <addColumn tableName="URL">
            <column name="FINAL_URL" type="VARCHAR(2048)"/>
            <column name="CHAIN_CHECKED_AT" type="TIMESTAMP"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="URL" columnName="CHAIN_CHECKED_AT"/>
            <dropColumn tableName="URL" columnName="FINAL_URL"/>
        </rollback>
    </changeSet>

    <changeSet author="khrvacic" id="024-blocklist-source-table">
        <createTable tableName="blocklist_source">
            <column name="id" type="BIGINT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)">
                <constraints nullable="false"/>
            </column>
            <column name="url" type="VARCHAR(1000)">
                <constraints nullable="false"/>
            </column>
            <column name="fallback_urls" type="TEXT"/>
            <column name="kind" type="VARCHAR(16)" defaultValue="DOMAINS">
                <constraints nullable="false"/>
            </column>
            <column name="action" type="VARCHAR(10)">
                <constraints nullable="false"/>
            </column>
            <column name="enabled" type="BOOLEAN" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="refresh_interval_hours" type="INT" defaultValueNumeric="6">
                <constraints nullable="false"/>
            </column>
            <column name="last_fetched_at" type="TIMESTAMP"/>
            <column name="last_success_at" type="TIMESTAMP"/>
            <column name="last_success_url" type="VARCHAR(2048)"/>
            <column name="domain_count" type="BIGINT"/>
            <column name="list_version" type="VARCHAR(64)"/>
            <column name="last_error" type="TEXT"/>
            <column name="etag" type="VARCHAR(255)"/>
            <column name="last_modified" type="VARCHAR(100)"/>
        </createTable>
        <rollback>
            <dropTable tableName="blocklist_source"/>
        </rollback>
    </changeSet>

