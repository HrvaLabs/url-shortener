<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet author="khrvacic" id="040-user-inactivity-warning">
        <addColumn tableName="user_account">
            <column name="last_active_at" type="TIMESTAMP"/>
            <column name="inactivity_warned_at" type="TIMESTAMP"/>
        </addColumn>
        <rollback>
            <dropColumn tableName="user_account" columnName="inactivity_warned_at"/>
            <dropColumn tableName="user_account" columnName="last_active_at"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
