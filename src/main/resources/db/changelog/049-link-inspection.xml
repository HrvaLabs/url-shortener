<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
        https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.9.xsd">

    <changeSet author="khrvacic" id="049-link-inspection">
        <createTable tableName="link_inspection">
            <column name="url_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_link_inspection" nullable="false"/>
            </column>
            <column name="screenshot_state" type="VARCHAR(20)"/>
            <column name="screenshot_requested_at" type="TIMESTAMP"/>
            <column name="screenshot_requested_by" type="VARCHAR(10)"/>
            <column name="screenshot_taken_at" type="TIMESTAMP"/>
            <column name="screenshot_url" type="TEXT"/>
            <column name="page_title" type="TEXT"/>
            <column name="page_status" type="INT"/>
            <column name="screenshot_failure" type="VARCHAR(255)"/>
        </createTable>
        <addForeignKeyConstraint baseTableName="link_inspection" baseColumnNames="url_id" constraintName="fk_link_inspection_url"
                                 referencedTableName="url" referencedColumnNames="id" onDelete="CASCADE"/>
        <createIndex tableName="link_inspection" indexName="idx_link_inspection_screenshot_state">
            <column name="screenshot_state"/>
            <column name="screenshot_requested_at"/>
        </createIndex>
        <rollback>
            <dropTable tableName="link_inspection"/>
        </rollback>
    </changeSet>

    <changeSet author="khrvacic" id="049-link-screenshot">
        <createTable tableName="link_screenshot">
            <column name="url_id" type="BIGINT">
                <constraints primaryKey="true" primaryKeyName="pk_link_screenshot" nullable="false"/>
            </column>
            <column name="image" type="BYTEA">
                <constraints nullable="false"/>
            </column>
            <column name="content_type" type="VARCHAR(30)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="link_screenshot" baseColumnNames="url_id" constraintName="fk_link_screenshot_url"
                                 referencedTableName="url" referencedColumnNames="id" onDelete="CASCADE"/>
        <rollback>
            <dropTable tableName="link_screenshot"/>
        </rollback>
    </changeSet>

</databaseChangeLog>
